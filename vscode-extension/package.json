{
  "name": "brainclaw-vscode",
  "displayName": "Brainclaw",
  "description": "Real-time agent coordination board for brainclaw",
  "version": "0.3.2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.brainclaw",
    "workspaceContains:**/.brainclaw"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "brainclaw-explorer",
          "title": "Brainclaw",
          "icon": "media/brainclaw-logo.svg"
        }
      ]
    },
    "views": {
      "brainclaw-explorer": [
        {
          "id": "brainclaw.agentBoard",
          "name": "Live Coordination Board"
        }
      ]
    },
    "commands": [
      {
        "command": "brainclaw.showBoard",
        "title": "Brainclaw: Show Agent Board"
      },
      {
        "command": "brainclaw.refreshBoard",
        "title": "Brainclaw: Refresh Board",
        "icon": "$(refresh)"
      },
      {
        "command": "brainclaw.acceptCandidate",
        "title": "Accept",
        "icon": "$(check)"
      },
      {
        "command": "brainclaw.rejectCandidate",
        "title": "Reject",
        "icon": "$(close)"
      },
      {
        "command": "brainclaw.releaseClaim",
        "title": "Release Claim",
        "icon": "$(unlock)"
      },
      {
        "command": "brainclaw.approveAction",
        "title": "Approve",
        "icon": "$(check)"
      },
      {
        "command": "brainclaw.rejectAction",
        "title": "Reject",
        "icon": "$(close)"
      },
      {
        "command": "brainclaw.dispatchPlan",
        "title": "Dispatch Plan",
        "icon": "$(run)"
      },
      {
        "command": "brainclaw.quickCapture",
        "title": "Brainclaw: Quick Capture",
        "icon": "$(add)"
      },
      {
        "command": "brainclaw.claimScope",
        "title": "Brainclaw: Claim this scope"
      },
      {
        "command": "brainclaw.addTrap",
        "title": "Brainclaw: Add trap here"
      },
      {
        "command": "brainclaw.viewMemory",
        "title": "Brainclaw: View memory for scope"
      },
      {
        "command": "brainclaw.dispatch",
        "title": "Brainclaw: Dispatch",
        "icon": "$(run-all)"
      },
      {
        "command": "brainclaw.search",
        "title": "Brainclaw: Search",
        "icon": "$(search)"
      },
      {
        "command": "brainclaw.doctor",
        "title": "Brainclaw: Doctor",
        "icon": "$(stethoscope)"
      },
      {
        "command": "brainclaw.openEntity",
        "title": "Brainclaw: Open entity preview"
      },
      {
        "command": "brainclaw.refreshEntityPreview",
        "title": "Brainclaw: Refresh entity preview"
      },
      {
        "command": "brainclaw.openWorktree",
        "title": "Open worktree in new window",
        "icon": "$(empty-window)"
      },
      {
        "command": "brainclaw.showCapturedLogs",
        "title": "Show captured logs",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "brainclaw.openEntity",
          "when": "false"
        },
        {
          "command": "brainclaw.refreshEntityPreview",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "brainclaw.refreshBoard",
          "when": "view == brainclaw.agentBoard",
          "group": "navigation"
        },
        {
          "command": "brainclaw.dispatch",
          "when": "view == brainclaw.agentBoard",
          "group": "navigation"
        },
        {
          "command": "brainclaw.quickCapture",
          "when": "view == brainclaw.agentBoard",
          "group": "navigation"
        },
        {
          "command": "brainclaw.search",
          "when": "view == brainclaw.agentBoard",
          "group": "navigation"
        },
        {
          "command": "brainclaw.doctor",
          "when": "view == brainclaw.agentBoard",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "brainclaw.acceptCandidate",
          "when": "viewItem == candidate",
          "group": "inline"
        },
        {
          "command": "brainclaw.rejectCandidate",
          "when": "viewItem == candidate",
          "group": "inline"
        },
        {
          "command": "brainclaw.releaseClaim",
          "when": "viewItem == claim",
          "group": "inline"
        },
        {
          "command": "brainclaw.approveAction",
          "when": "viewItem == action",
          "group": "inline"
        },
        {
          "command": "brainclaw.rejectAction",
          "when": "viewItem == action",
          "group": "inline"
        },
        {
          "command": "brainclaw.dispatchPlan",
          "when": "viewItem == plan",
          "group": "inline"
        },
        {
          "command": "brainclaw.openWorktree",
          "when": "viewItem == assignment || viewItem == assignment-terminal || viewItem == claim || viewItem == run",
          "group": "triage@1"
        },
        {
          "command": "brainclaw.showCapturedLogs",
          "when": "viewItem == assignment || viewItem == assignment-terminal || viewItem == run",
          "group": "triage@2"
        }
      ],
      "explorer/context": [
        {
          "command": "brainclaw.claimScope",
          "when": "brainclaw.active",
          "group": "brainclaw@1"
        },
        {
          "command": "brainclaw.addTrap",
          "when": "brainclaw.active",
          "group": "brainclaw@2"
        },
        {
          "command": "brainclaw.viewMemory",
          "when": "brainclaw.active",
          "group": "brainclaw@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "brainclaw.dispatch",
        "key": "ctrl+alt+d",
        "when": "brainclaw.active"
      },
      {
        "command": "brainclaw.search",
        "key": "ctrl+alt+f",
        "when": "brainclaw.active"
      },
      {
        "command": "brainclaw.doctor",
        "key": "ctrl+alt+h",
        "when": "brainclaw.active"
      }
    ],
    "configuration": {
      "title": "Brainclaw",
      "properties": {
        "brainclaw.notifications": {
          "type": "string",
          "enum": [
            "urgent",
            "all",
            "none"
          ],
          "default": "urgent",
          "description": "Controls Brainclaw action-required notifications."
        },
        "brainclaw.refreshIntervalMs": {
          "type": "number",
          "default": 30000,
          "minimum": 0,
          "description": "Polling interval for refreshing the Brainclaw board summary. Set to 0 to disable polling. Ignored when brainclaw.observerMode is enabled (the journal file-watch drives refresh instead)."
        },
        "brainclaw.observerMode": {
          "type": "boolean",
          "default": true,
          "description": "Drive board refresh from the append-only event journal (.brainclaw/events) via a file-watch instead of the polling timer, and maintain an in-memory projection (pln#560). When the journal is off/absent the surface degrades gracefully to a single lock-free board_summary read driven by the legacy event watch. The attention badge and claims/actions counts are seeded from board_summary until those families are journaled with payloads (phase 1.5). Set to false to force the legacy polling timer."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json",
    "test": "tsc -p ./tsconfig.json && node --test out/tree-helpers.test.js out/project-discovery.test.js out/acceptance-bar.test.js out/content-provider.test.js out/refresh-diff.test.js out/journal-consumer.test.js out/board-projection.test.js out/board-observer.test.js out/brainclaw-resolver.test.js"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^6.0.3"
  }
}
