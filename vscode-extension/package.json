{
  "name": "brainclaw-vscode",
  "displayName": "Brainclaw",
  "description": "Real-time agent coordination board for brainclaw",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.brainclaw"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "brainclaw-explorer",
          "title": "Brainclaw",
          "icon": "media/brainclaw-logo.svg"
        }
      ]
    },
    "views": {
      "brainclaw-explorer": [
        {
          "id": "brainclaw.agentBoard",
          "name": "Live Coordination Board"
        }
      ]
    },
    "commands": [
      {
        "command": "brainclaw.showBoard",
        "title": "Brainclaw: Show Agent Board"
      },
      {
        "command": "brainclaw.clearNotifications",
        "title": "Brainclaw: Clear Event Notifications"
      },
      {
        "command": "brainclaw.refreshBoard",
        "title": "Brainclaw: Refresh Board",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "brainclaw.refreshBoard",
          "when": "view == brainclaw.agentBoard",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "watch": "tsc -watch -p ./tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
